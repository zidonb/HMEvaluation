print(f"  Partially Correct: {category_counts['Partially Correct']} ({category_counts['Partially Correct']/num_questions*100:.1f}%)")
print(f"  Incorrect: {category_counts['Incorrect']} ({category_counts['Incorrect']/num_questions*100:.1f}%)")
