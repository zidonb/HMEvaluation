# Initialize Together client
together_client = Together(api_key=TOGETHER_API_KEY)

# Read the Excel file
df = pd.read_excel('mapping.xlsx')

# LIMIT: Set to None to evaluate all rows, or a number to limit (e.g., 5)
MAX_ROWS_TO_EVALUATE = 5  # Change this to your desired number, or None for all

if MAX_ROWS_TO_EVALUATE is not None:
    df = df.head(MAX_ROWS_TO_EVALUATE)
    print(f"Limiting evaluation to first {MAX_ROWS_TO_EVALUATE} rows\n")
    
# Prepare results storage
results = []
total_score = 0
category_counts = {"Correct": 0, "Partially Correct": 0, "Incorrect": 0}

print("Starting answer quality evaluation...\n")

# Iterate through each row
for idx, row in df.iterrows():
    document_name = row['Document_Name']
    question = row['Question']
    gold_answer = row['Answer']
    
    print(f"Processing {idx + 1}/{len(df)}: {document_name}")
    
    try:
        # Step 1: Get answer from Nuclia
        response = sdk.NucliaSearch().ask(
            query={
                "query": question,
                "rephrase": True,
            }
        )
        
        nuclia_answer = response.answer
        if isinstance(nuclia_answer, bytes):
            nuclia_answer = nuclia_answer.decode("utf-8")
        
        # Step 2: Evaluate with LLM
        evaluation_prompt = f"""You are evaluating answers for מפקח במס הכנסה (Israeli Tax Authority Inspector).

Your task is to evaluate if the "Nuclia Answer" aligns with and correctly answers the question based on the "Gold Answer" (the professionally verified correct answer).

**Question:**
{question}

**Gold Answer (Expected):**
{gold_answer}

**Nuclia Answer (To Evaluate):**
{nuclia_answer}

Please evaluate the Nuclia Answer and respond ONLY with a valid JSON object in this exact format:
{{
  "score": <number 0-100>,
  "category": "<Correct|Partially Correct|Incorrect>",
  "reasoning": "<brief explanation of your evaluation>",
  "missing_info": "<what important information is missing, if any>",
  "factual_errors": "<any factual errors found, or 'None'>"
}}

Evaluation criteria:
- Score 90-100: Answer is accurate, complete, and fully aligned with gold answer
- Score 70-89: Answer is mostly correct but missing some details or has minor issues
- Score 50-69: Answer is partially correct but has significant gaps or inaccuracies
- Score 0-49: Answer is incorrect or misleading

Respond ONLY with the JSON object, no other text."""

        llm_response = together_client.chat.completions.create(
            model="openai/gpt-oss-120b",
            messages=[
                {
                    "role": "user",
                    "content": evaluation_prompt
                }
            ],
            temperature=0.1  # Low temperature for consistent evaluation
        )
        
        # Parse LLM response
        llm_content = llm_response.choices[0].message.content.strip()
        
        # Try to extract JSON if there's extra text
        if "```json" in llm_content:
            llm_content = llm_content.split("```json")[1].split("```")[0].strip()
        elif "```" in llm_content:
            llm_content = llm_content.split("```")[1].split("```")[0].strip()
        
        evaluation = json.loads(llm_content)
        
        # Extract evaluation fields
        score = evaluation.get("score", 0)
        category = evaluation.get("category", "Unknown")
        reasoning = evaluation.get("reasoning", "")
        missing_info = evaluation.get("missing_info", "")
        factual_errors = evaluation.get("factual_errors", "")
        
        # Update totals
        total_score += score
        if category in category_counts:
            category_counts[category] += 1
        
        # Store results
        result = {
            'Document_Name': document_name,
            'Question': question,
            'Gold_Answer': gold_answer,
            'Nuclia_Answer': nuclia_answer,
            'Score': score,
            'Category': category,
            'Reasoning': reasoning,
            'Missing_Info': missing_info,
            'Factual_Errors': factual_errors
        }
        results.append(result)
        
        # Print progress
        print(f"  Score: {score}/100 | Category: {category}")
        print(f"  Reasoning: {reasoning[:100]}...")
        print()
        
    except Exception as e:
        print(f"  ERROR: {str(e)}")
        # Store error result
        result = {
            'Document_Name': document_name,
            'Question': question,
            'Gold_Answer': gold_answer,
            'Nuclia_Answer': 'ERROR',
            'Score': 0,
            'Category': 'Error',
            'Reasoning': str(e),
            'Missing_Info': '',
            'Factual_Errors': ''
        }
        results.append(result)
        print()

# Calculate final metrics
num_questions = len(df)
average_score = total_score / num_questions if num_questions > 0 else 0

